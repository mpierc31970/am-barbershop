  "narrative": {
    "northStar": "The Colour Fan Deck",
    "overview": "Paths and add-ons are colour blades on one rivet, each carrying its own name and live catalog price, so choosing a website reads like choosing a colour. White card stock and cool grey carry the page; saturated chip fields own whole regions under a closed colour code; ink is the action colour; an ink footer is the deck's back cover.",
    "keyCharacteristics": [
      "Closed colour code: cobalt Standard, berry Studio, leaf money kept, tangerine money taken, marigold fine print, violet/teal/rose/sky add-on ring.",
      "Anybody across its width axis over Hanken Grotesk; tabular figures in condensed Anybody.",
      "16px blades with a 12px rivet ring; one lift shadow.",
      "Fine print printed loud on a marigold band."
    ],
    "rules": [
      {
        "name": "The closed code rule",
        "body": "A chip never decorates a region that lacks its meaning. Red only marks form errors."
      },
      {
        "name": "The descent rule",
        "body": "Pages move card, path field, stock, marigold band, ink cover."
      },
      {
        "name": "The label grid",
        "body": "Every blade shows chip, number, name, tagline, price run, in that order."
      },
      {
        "name": "Motion follows input",
        "body": "Only the lift, the spread, the row press and the menu slide move; nothing on scroll or load."
