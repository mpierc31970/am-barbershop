{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -w @cds/web -- -p 3100",
      "startServerReadyPattern": "Ready|started server",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://blocks.localhost:3100/",
        "http://blocks.localhost:3100/gallery",
        "http://blocks.localhost:3100/visit",
        "http://intake-complete.sites.localhost:3100/",
        "http://localhost:3100/report",
        "http://localhost:3100/",
        "http://localhost:3100/pricing",
        "http://localhost:3100/studio",
        "http://localhost:3100/add-ons",
        "http://localhost:3100/add-ons/testimonials",
        "http://localhost:3100/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://blocks\\.localhost",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://[a-z0-9-]+\\.sites\\.localhost",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/report",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/(\\?|$|standard|studio|pricing|add-ons|contact)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
