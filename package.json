  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "0.15.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "jsdom": "^30.1.1",
