{
  "name": "cds-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/addons/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "pretypecheck": "npm run addons:check && npm run legal:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0 && prettier --check . && npm run typecheck",
    "format": "prettier --write .",
    "pretest": "npm run addons:check && npm run legal:check",
    "test": "vitest run",
    "prebuild": "npm run addons:check && npm run legal:check",
    "build": "npm run typecheck && npm run build -w @cds/web",
    "db:pb:fetch": "node packages/db/scripts/fetch-pocketbase.mjs",
    "db:migrate:dev": "node packages/db/scripts/migrate-dev.mjs",
    "db:restore-rehearse": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/db-restore-rehearse.ts",
    "db:migrations:assemble": "node packages/db/scripts/migrations-dir.mjs",
    "addons:gen": "node packages/addon-registry/scripts/gen.mjs",
    "addons:check": "node packages/addon-registry/scripts/gen.mjs --check",
    "legal:gen": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/core/scripts/legal-gen.ts",
    "legal:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/core/scripts/legal-gen.ts --check",
    "design:engine:fetch": "node scripts/impeccable/fetch-engine.mjs",
    "design:detect": "node scripts/impeccable/design-detect.mjs",
    "docs:fields": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/render-field-docs.ts",
    "theme:import": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/theme-import.ts",
    "addons:install": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/addons-install.ts",
    "tenants:export": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/tenants-export.ts",
    "quotes:run": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/quotes-run.ts",
