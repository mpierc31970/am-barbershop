    "support:run": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/support-run.ts",
    "domains:check": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/domains-check.ts",
    "hub:claims": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/hub-claims.ts",
    "hub:cutover": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/hub-cutover.ts",
    "domains:move": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/domains-move.ts",
    "domains:run": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/domains-run.ts",
