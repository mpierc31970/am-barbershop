    "media:takedown": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/media-takedown.ts",
    "agreements:verify": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/agreements-verify.ts",
    "fit:review": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/fit-review.ts",
    "site:assemble": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/site-assemble.ts",
    "prices:set": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning --import ./packages/db/scripts/register-ts.mjs packages/db/scripts/prices-set.ts",
